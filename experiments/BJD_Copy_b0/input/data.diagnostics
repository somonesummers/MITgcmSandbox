# Diagnostic Package Choices
#
# 2-D fields:
# =================
# 
# ETAN     Perturbation of Surface (pressure, height) (Pa,m)
# 
# monthly 3-D fields:
# ===================
# 
# SALTanom Salt anomaly (=SALT-35; g/kg)
# THETA    Potential Temperature (degC,K)
# UVELMASS Zonal Mass-Weighted Comp of Velocity (m/s)
# VVELMASS Meridional Mass-Weighted Comp of Velocity (m/s)
# WVELMASS Vertical Mass-Weighted Comp of Velocity (m/s)
#
 &diagnostics_list
   fields(1:5,1)='THETA','SALT','UVEL','WVEL','VVEL',
   fileName(1)='dynDiag',
   frequency(1)=432000,
   timePhase(1)=0.00000000e+00,
   fields(1:4,2)='UVELSLT ','UVELTH  ','WVELSLT ','WVELTH  ',
   fileName(2)='fluxDiag',
   frequency(2)=432000,
   timePhase(2)=0.00000000e+00,
   fields(1:3,3)='BRGfwFlx','BRGhtFlx','BRGmltRt',
   fileName(3)='BRGFlx',
   frequency(3)=432000,
   timePhase(3)=0.00000000e+00,
   frequency(8) = 432000.,
   fields(1,8) = 'BRGfwFlx',
   filename(8) = 'BRGfwFlx', 
   frequency(9) = 432000.,
   fields(1,9) = 'BRGhtFlx',
   filename(9) = 'BRGhtFlx',
   frequency(10) = 432000.,
   fields(1,10) = 'BRGmltRt',
   filename(10) = 'BRGmltRt', 
   frequency(11) = 432000.,
   fields(1,11) = 'icefrntW',
   filename(11) = 'icefrntW', 
   frequency(12) = 432000.,
   fields(1,12) = 'icefrntT',
   filename(12) = 'icefrntT',
   frequency(13) = 432000.,
   fields(1,13) = 'icefrntS',
   filename(13) = 'icefrntS',
   frequency(14) = 432000.,
   fields(1,14) = 'icefrntR',
   filename(14) = 'icefrntR',
   frequency(15) = 432000.,
   fields(1,15) = 'icefrntM',
   filename(15) = 'icefrntM',
   frequency(16) = 432000.,
   fields(1,16) = 'icefrntA',
   filename(16) = 'icefrntA', 
